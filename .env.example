# Copy this to a private .env.local file, or configure these in your host's environment.
# Node.js 22.13+ is required; Node.js 24 LTS is recommended.
DATA_DIR=./data
APP_URL=http://localhost:3000

# Generate with `npm run setup`, or `node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"`.
# Used only to create the first administrator. Never put this in a NEXT_PUBLIC_ variable.
ADMIN_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters

# Optional: set to 1 only when creating a standalone deployment manually.
# Docker enables this at build time. Leave unset for normal Node.js/cPanel builds.
# NEXT_STANDALONE=1
